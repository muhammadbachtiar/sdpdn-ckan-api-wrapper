# ---- Server ----
PORT=3000
# URL publik wrapper (dipakai untuk membentuk field "endpoint" pada datalist)
WRAPPER_PUBLIC_URL=http://localhost:3000

# ---- Database (MySQL) ----
DATABASE_URL="mysql://root:password@localhost:3306/sdpdn_wrapper"

# ---- JWT dari SPLP (validasi pasif) ----
SPLP_JWT_SECRET=ganti-dengan-secret-dari-splp
SPLP_JWT_ALGORITHM=HS256
# Opsional: aktifkan jika SPLP menyertakan claim iss / aud
# SPLP_JWT_ISSUER=
# SPLP_JWT_AUDIENCE=

# ---- Admin API (CRUD mapping via Swagger) ----
ADMIN_API_KEY=ganti-dengan-api-key-admin-yang-panjang

# ---- CKAN (read-only, publik tanpa token) ----
CKAN_BASE_URL=https://opendata.muaraenimkab.go.id
CKAN_TIMEOUT_MS=15000

# ---- Default wilayah (dipakai jika tidak di-override) ----
DEFAULT_KODE_PROVINSI=16
DEFAULT_KODE_KAB_KOTA=16.03
